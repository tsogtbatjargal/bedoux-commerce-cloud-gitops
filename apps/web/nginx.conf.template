server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Mirrors the Kubernetes Ingress: "/" -> frontend, "/api" -> API Service
    # (docs/architecture.md). Compose sets API_UPSTREAM to the api service's
    # Compose DNS name; Kubernetes replaces this whole proxy with Ingress.
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri /index.html;
    }
}
