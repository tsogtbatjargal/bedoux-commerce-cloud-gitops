# P12.1 DNS/TLS profile. Copy to an ignored .tfvars file only after the owner
# confirms control of bedoux.ca's registrar nameservers, the intentional Shopify
# retirement, hosted-zone persistence, and opens the bounded AWS session.
aws_region  = "ca-central-1"
aws_profile = "bedoux-admin"

route53_acm_enabled                   = true
route53_acm_certificate_enabled       = true
route53_acm_domain_name               = "bedoux.ca"
route53_acm_subject_alternative_names = ["www.bedoux.ca"]
route53_aliases_enabled                = false
route53_alias_target_dns_name          = ""
route53_alias_target_zone_id           = ""

# Keep unrelated optional profiles disabled.
rds_enabled             = false
s3_images_enabled       = false
secrets_manager_enabled = false
observability_enabled   = false
