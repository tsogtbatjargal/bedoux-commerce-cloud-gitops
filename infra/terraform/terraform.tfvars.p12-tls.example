# P12.1 DNS/TLS profile. Copy to an ignored .tfvars file only after the owner
# confirms control of bedoux.com, registrar nameserver access, hosted-zone
# persistence, and opens the bounded AWS session.
aws_region  = "ca-central-1"
aws_profile = "bedoux-admin"

route53_acm_enabled                   = true
route53_acm_certificate_enabled       = true
route53_acm_domain_name               = "bedoux.com"
route53_acm_subject_alternative_names = ["www.bedoux.com"]

# Keep unrelated optional profiles disabled.
rds_enabled             = false
s3_images_enabled       = false
secrets_manager_enabled = false
observability_enabled   = false
