aws_region              = "ca-central-1"
aws_profile             = "bedoux-admin"
cluster_name            = "bedoux"
kubernetes_version      = "1.34"
availability_zones      = ["ca-central-1a", "ca-central-1b"]
public_subnet_cidrs     = ["10.42.0.0/20", "10.42.16.0/20"]
node_instance_types     = ["t3.medium"]
node_capacity_type      = "SPOT"
node_desired_size       = 1
node_min_size           = 1
node_max_size           = 1
node_disk_size_gib      = 20
ebs_csi_addon_version = "v1.63.1-eksbuild.1"
vpc_cni_addon_version = "v1.22.4-eksbuild.3"

# P7.1 only: keep this false for P6-only sessions. For an approved, time-bounded
# RDS exercise set rds_enabled=true and supply TF_VAR_rds_master_password outside
# this file. Never commit the password or a rendered DATABASE_URL.
rds_enabled               = false
rds_database_name         = "bedoux"
rds_master_username       = "bedoux"
rds_instance_class        = "db.t4g.micro"
rds_allocated_storage_gib = 20

# P7.2 only: keep false for P6/P7.1 sessions. An approved P7.2 session sets
# s3_images_enabled=true; Terraform stages only the synthetic SVG assets and
# creates a temporary least-privilege API IRSA role.
s3_images_enabled = false

# P7.3 only: keep false outside an approved RDS + Secrets Manager session. The
# secret value is assembled by Terraform from the out-of-band RDS password and
# held in encrypted state; never put a password or DATABASE_URL in this file.
secrets_manager_enabled   = false
secrets_manager_secret_name = "bedoux-rds-credentials"

# P12.1 only: keep false until ADR 0022's apex-cutover, persistence,
# session, and exact-plan gates are satisfied. Terraform does not manage registrar settings.
route53_acm_enabled                   = false
route53_acm_certificate_enabled       = false
route53_acm_domain_name               = "bedoux.ca"
route53_acm_subject_alternative_names = ["www.bedoux.ca"]
