# P11.2 bounded HA session profile. Copy to an ignored .tfvars file only after
# the owner opens the AWS session and completes docs/runbooks/aws-session.md.
aws_region         = "ca-central-1"
aws_profile        = "bedoux-admin"
cluster_name       = "bedoux"
kubernetes_version = "1.34"

# The VPC module creates exactly these two public subnets. P11.4 opts into one
# fixed one-node managed group per subnet so the healthy baseline is guaranteed
# to have one Spot node per AZ while the aggregate node ceiling stays at two.
availability_zones      = ["ca-central-1a", "ca-central-1b"]
public_subnet_cidrs     = ["10.42.0.0/20", "10.42.16.0/20"]
# Keep each fixed one-node AZ group flexible without changing the two-node
# aggregate ceiling. These x86_64 general-purpose types have the same shape.
node_instance_types     = ["t3.medium", "t3a.medium"]
node_capacity_type      = "SPOT"
node_groups_per_az      = true
node_desired_size       = 2
node_min_size           = 2
node_max_size           = 2
node_disk_size_gib      = 20
ebs_csi_addon_version   = "v1.63.1-eksbuild.1"
vpc_cni_addon_version   = "v1.22.4-eksbuild.3"

rds_enabled             = false
s3_images_enabled       = false
secrets_manager_enabled = false
observability_enabled   = false
