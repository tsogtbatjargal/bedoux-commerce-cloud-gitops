# Everything in this repo targets Linux (workstation, containers, CI, EKS).
# Force LF so bash, Make, Terraform, and Helm never see CRLF.
*.sh            text eol=lf
*.bash          text eol=lf
Makefile        text eol=lf
*.mk            text eol=lf
*.env.example   text eol=lf
*.tf            text eol=lf
*.tfvars        text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
