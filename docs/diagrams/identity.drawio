        <mxCell id="admin-trust" value="Trust:&#xa;IAM user, MFA console login&#xa;(no long-lived key for routine use)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="admin">
          <mxGeometry x="20" y="54" width="260" height="90" as="geometry"/>
