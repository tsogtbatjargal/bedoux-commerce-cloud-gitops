        <mxCell id="title" value="Bedoux Commerce Cloud — Five Distinct IAM Identities" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="600" height="40" as="geometry"/>
